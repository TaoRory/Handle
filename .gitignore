# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template README tells contributors to copy. It holds no secrets.
!.env.example

# vercel
.vercel

# supabase cli local state — records which developer's project the working
# copy is linked to. Machine-specific, and not something main should pin.
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
