# Canonical origin. Used by metadataBase, sitemap.xml, robots.txt and the
# JSON-LD graph. Must include the protocol and no trailing slash.
# Falls back to https://handle.vn when unset.
NEXT_PUBLIC_SITE_URL=https://handle.vn

# Supabase, for the consultation form. Optional: leave these unset and the site
# runs normally, with the form reporting a failure instead of writing a row.
# Both are public values — the anon key ships in the browser bundle, so what
# actually protects the data is the Row Level Security policy on
# `consultation_requests`. Confirm anon is allowed to INSERT and nothing else
# before pointing this at a real project.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
