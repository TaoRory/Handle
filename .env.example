# Template only. Copy to .env.local and put real values there — .env.local is
# gitignored, this file is committed to a public repository.

# Canonical origin. Used by metadataBase, sitemap.xml, robots.txt and the
# JSON-LD graph. Must include the protocol and no trailing slash.
# Falls back to https://handle.vn when unset.
NEXT_PUBLIC_SITE_URL=https://handlevietnam.com

# Supabase, for the consultation form. Optional: leave these unset and the site
# runs normally, with the form reporting a failure instead of writing a row.
# Set both or neither — half-configured is the one state that is not handled.
#
# Both are public values: the anon key ships in the browser bundle either way,
# so what actually protects submitted data is the Row Level Security policy on
# `consultation_requests`. Confirm anon is allowed to INSERT and nothing else
# before pointing this at a real project.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
